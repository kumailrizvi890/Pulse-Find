# Copy to .env.local and fill in from your Supabase project (Project Settings → API).
# The demo at /demo works with no env vars at all; these are only needed
# for accounts, the job board and the MCP server. See docs/SELF_HOST.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: the public URL, used for social share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tracker sync: server only, never share these values.
# SUPABASE_SERVICE_ROLE_KEY: the service_role key from Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
# SYNC_OWNER_USER_ID: your Supabase auth user UUID (the user whose tracker syncs).
SYNC_OWNER_USER_ID=
# CRON_SECRET: any random string; it must match the CRON_SECRET set where the
# sync cron runs (Vercel env vars), since the cron route checks it.
CRON_SECRET=
